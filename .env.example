# --- Discord ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application ID from the same app's "General Information" page
DISCORD_APP_ID=

# Optional: a single guild id for fast slash-command registration during dev.
# Leave empty for global registration (slower to propagate, ~1h).
DISCORD_GUILD_ID=

# Comma-separated list of Discord user ids who can run admin commands
# (e.g. listing other people's characters, future /sim run-all).
DISCORD_ADMIN_USER_IDS=

# --- Storage ---
DB_PATH=./data/bot.db

# --- Sim worker pacing (Phase 2 stub uses these for real) ---
# Random delay between consecutive sim jobs.
SIM_MIN_DELAY_SECONDS=75
SIM_MAX_DELAY_SECONDS=120
# Hard cap on completed sims per UTC day.
SIM_DAILY_CAP=30
# Optional UTC active window. Empty = always. Format "HH-HH", e.g. "03-10".
# Wrap-around supported, e.g. "22-04" for nightly 22:00-04:00 UTC.
SIM_ACTIVE_HOURS_UTC=

# --- Raidbots automation ---
# stub      = fake URLs (default; safe for dev)
# playwright = real Chromium hitting raidbots.com (USE WITH RESPECT)
RAIDBOTS_EXECUTOR=stub
# Persistent Chromium profile dir — keeps cookies/login across restarts so the
# site sees the same "user". One-time login to raidbots in this profile is
# recommended (especially if you're a Patreon supporter — you get higher
# legitimate quotas).
PLAYWRIGHT_USER_DATA_DIR=./data/chromium-profile
# true = run hidden, false = show the browser window (helpful for first login
# and for debugging selector failures).
PLAYWRIGHT_HEADLESS=true

# Raidbots login (optional — only used when the persistent profile's session
# has expired). If unset, an expired session marks the job failed and the
# admin must re-login manually.
RAIDBOTS_EMAIL=
RAIDBOTS_PASSWORD=

# --- /sim request-simcs ---
# Optional cron expression (5-field, UTC) that automatically fires
# `/sim request-simcs mode:all`. Empty = disabled. Examples:
#   0 18 * * 0     every Sunday at 18:00 UTC
#   0 9 * * 1,4    every Monday and Thursday at 09:00 UTC
REQUEST_SIMCS_CRON=
# Days a simc can sit unmodified before the request DM flags it as stale.
REQUEST_SIMCS_STALE_DAYS=7

# --- Logging ---
LOG_LEVEL=info
