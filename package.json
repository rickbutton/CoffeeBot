{
    "name": "coffeebot",
    "version": "0.1.0",
    "private": true,
    "description": "Discord bot that collects WoW SimulationCraft exports, runs Raidbots droptimizer sims on a weekly cadence, and publishes the results to a managed status channel.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node --enable-source-maps dist/index.js",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:coverage:open": "vitest run --coverage && start coverage/index.html",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:pull-prod": "fly ssh console -C \"sqlite3 /data/bot.db '.backup /data/snapshot.db'\" && node -e \"['./data/bot.db','./data/bot.db-wal','./data/bot.db-shm'].forEach(f=>{try{require('fs').rmSync(f)}catch{}})\" && fly ssh sftp get /data/snapshot.db ./data/bot.db && fly ssh console -C \"rm /data/snapshot.db\"",
        "sim:test-once": "tsx src/raidbots/test-sim.ts",
        "qelive:test-once": "tsx src/qelive/test-sim.ts",
        "wowutils:script": "tsx src/wowutils/generate-script.ts",
        "wowaudit:test": "tsx src/wowaudit/test-flow.ts",
        "docker:build": "docker build -t coffeebot:dev .",
        "docker:run": "docker run -d --rm --name coffeebot --env-file .env -e DB_PATH=/data/bot.db -e PLAYWRIGHT_USER_DATA_DIR=/data/chromium-profile -e QELIVE_USER_DATA_DIR=/data/qelive-profile -v \"./data:/data\" coffeebot:dev",
        "docker:logs": "docker logs -f coffeebot",
        "docker:stop": "docker stop coffeebot",
        "fly:deploy": "fly deploy",
        "fly:start": "fly machines start",
        "fly:stop": "fly machines stop",
        "fly:logs": "fly logs",
        "fly:status": "fly status",
        "fly:ssh": "fly ssh console",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "better-sqlite3": "^12.9.0",
        "cron": "^4.4.0",
        "discord.js": "^14.26.3",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.59.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.6.0",
        "@vitest/coverage-v8": "^4.1.5",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.3",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "vitest": "^4.1.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild"
        ]
    }
}
